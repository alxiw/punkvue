# Enforce LF endings across repository and working copy
* text=auto eol=lf

# Leave binary files untouched
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# Windows scripts (if present)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
